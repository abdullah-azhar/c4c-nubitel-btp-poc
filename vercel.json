{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "",
  "installCommand": "",
  "outputDirectory": "mock-nubitel/public",
  "rewrites": [
    { "source": "/config.js", "destination": "/api/config" },
    { "source": "/nubitel-api/:route", "destination": "/api/nubitel?route=:route" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Content-Security-Policy", "value": "frame-ancestors 'self' https://my335945.crm.ondemand.com" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    }
  ]
}
