# Copy to .env for your own reference. The servers read real environment variables.

# Shared by BTP view and Nubitel (Option B). Long and random. Never commit the real one.
TOKEN_SECRET=change-me

# BTP view
MESSAGE_ORIGINS=https://agent.nubitel.example
FRAME_ANCESTORS=https://agent.nubitel.example,https://myXXXXXX.crm.ondemand.com
C4C_UI_URL=https://myXXXXXX.crm.ondemand.com
SECTION_TIMEOUT_MS=6000
# Seconds the view reuses what it loaded when the agent switches back to a chat (0 = off)
CACHE_TTL_SECONDS=300

# Data source: mock (default) or c4c
DATA_SOURCE=mock
MOCK_LATENCY_SCALE=1
C4C_BASE_URL=https://myXXXXXX.crm.ondemand.com
C4C_USER=read-only-technical-user
C4C_PASSWORD=
C4C_TIMEOUT_MS=8000
# Optional custom object/report for recommended items, {accountId} is replaced
RECOMMENDED_ITEMS_PATH=
